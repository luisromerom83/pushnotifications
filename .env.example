# Puerto del servidor
PORT=3000

# Ruta alternativa al archivo de cuenta de servicio de Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# O bien, contenido JSON completo de la clave de servicio en una sola línea (útil para despliegues en la nube)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
